                className="bp-footer",
            ),
            className="text-center text-muted",
        ),
    ],
    fluid=True,
    className="bp-container",
)


# ============================================================================
# Callbacks & Interactivity
# ============================================================================

@callback(
    Output("hero-stats-container", "children"),
    Input("model-selector", "value"),
)
def update_hero_stats(selected_model):
    """Update hero statistics based on metadata."""
    stats = []
    if metadata:
        stats.append(("📊", f"{metadata.get('dataset_size', 0):,}", "Tweets Analyzed"))
        if metadata.get("models", {}).get("logistic_regression"):
            lr = metadata["models"]["logistic_regression"]
            stats.append(("⚡", f"{lr['accuracy']*100:.1f}%", "Logistic Regression"))
        if metadata.get("models", {}).get("bilstm"):
            ls = metadata["models"]["bilstm"]
            stats.append(("🧠", f"{ls['accuracy']*100:.1f}%", "BiLSTM"))

    if not stats:
        return dbc.Alert("No model metadata available.", color="info")

    cards = []
    for icon, value, label in stats:
        cards.append(
            dbc.Col(
                create_kpi_card(label, value, icon),
                md=3,
                className="mb-2",
            )
        )

    return dbc.Row(cards, className="g-2")


@callback(
    Output("predict-output", "children"),
    Input("predict-button", "n_clicks"),
    State("predict-textarea", "value"),
    State("model-selector", "value"),
    prevent_initial_call=True,
)
def handle_predict(n_clicks, text, model_choice):
    """Handle single tweet prediction."""
    if not model_choice or not available_models:
        return dbc.Alert("❌ No trained model available. Check model loading.", color="danger")

    if not text or not text.strip():
        return dbc.Alert("⚠️ Please enter a tweet.", color="warning")

    try:
        preds, conf, proba, classes = run_prediction_full([text], model_choice)
        sentiment = str(preds[0])
        confidence = float(conf[0])

        return dbc.Card(
            dbc.CardBody(
                [
                    html.H5("✅ Prediction Result", className="card-title mb-4"),
                    create_sentiment_badge(sentiment, confidence),
                    html.Hr(),
                    html.H6("📊 Class Probabilities", className="mt-4 mb-3"),
                    create_probability_bars(classes, proba[0]),
                    html.Hr(),
                    html.H6("🧹 Cleaned Text", className="mt-4 mb-3"),
                    dbc.Alert(
                        clean_tweet(text) or "(empty after cleaning)",
                        color="light",
                    ),
                ]
            ),
            className="result-card mt-4",
        )
    except Exception as e:
        return dbc.Alert(f"❌ Error during prediction: {str(e)}", color="danger")


@callback(
    [
        Output("batch-button", "disabled"),
        Output("batch-data-store", "data"),
        Output("batch-output", "children"),
    ],
    [
        Input("batch-upload", "contents"),
        Input("batch-button", "n_clicks"),
    ],
    [State("batch-upload", "filename"), State("model-selector", "value")],
    prevent_initial_call=True,
)
def handle_batch_analysis(contents, n_clicks, filename, model_choice):
    """Handle batch CSV analysis."""
    if not contents:
        return True, None, dbc.Alert("📤 Upload a CSV file to get started.", color="info")

    if not model_choice or not available_models:
        return False, None, dbc.Alert("❌ No trained model available.", color="danger")

    # Parse file
    data = parse_contents(contents, filename or "")
    if data is None or data.empty:
        return False, None, dbc.Alert("❌ Could not parse CSV file. Ensure it's a valid CSV.", color="danger")

    # Find text column
    text_col = next(
        (c for c in ["text", "tweet", "content", "SentimentText"] if c in data.columns),
        None,
    )
    if text_col is None:
        return False, None, dbc.Alert(
            "❌ CSV must contain one of: text, tweet, content, SentimentText.",
            color="danger",
        )

    if n_clicks and n_clicks > 0:
        try:
            texts_raw = data[text_col].astype(str).tolist()
            empty_mask = [not t.strip() for t in texts_raw]
            n_empty = sum(empty_mask)
            texts = [t for t, e in zip(texts_raw, empty_mask) if not e]

            if not texts:
                return False, None, dbc.Alert("⚠️ No non-empty text found.", color="warning")

            preds, conf, proba, classes = run_prediction_full(texts, model_choice)

            result_df = data[~pd.Series(empty_mask)].copy()
            result_df["predicted_sentiment"] = preds
            result_df["confidence"] = pd.Series(conf).round(3).values

            sentiment_series = pd.Series(preds)
            conf_series = pd.Series(conf)

            # Create output
            summary_row = dbc.Row(
                [
                    dbc.Col(
                        create_kpi_card("Tweets Analyzed", f"{len(texts):,}", "📊"),
                        md=3,
                    ),
                    dbc.Col(
                        create_kpi_card(
                            "Positive",
                            f"{(sentiment_series == 'positive').sum() / len(texts) * 100:.1f}%",
                            "😊",
                            SENTIMENT_COLORS["positive"],
                        ),
                        md=3,
                    ),
                    dbc.Col(
                        create_kpi_card(
                            "Neutral",
                            f"{(sentiment_series == 'neutral').sum() / len(texts) * 100:.1f}%",
                            "😐",
                            SENTIMENT_COLORS["neutral"],
                        ),
                        md=3,
                    ),
                    dbc.Col(
                        create_kpi_card(
                            "Negative",
                            f"{(sentiment_series == 'negative').sum() / len(texts) * 100:.1f}%",
                            "😞",
                            SENTIMENT_COLORS["negative"],
                        ),
                        md=3,
                    ),
                ],
                className="g-3 mb-4",
            )

            charts_row = dbc.Row(
                [
                    dbc.Col(
                        dcc.Graph(figure=create_sentiment_distribution_chart(sentiment_series)),
                        md=6,
                    ),
                    dbc.Col(
                        dcc.Graph(figure=create_confidence_histogram(conf_series)),
                        md=6,
                    ),
                ],
                className="g-3 mb-4",
            )

            # Results table
            results_table = dbc.Card(
                dbc.CardBody(
                    [
                        html.H6("📋 Prediction Results"),
                        html.Div(
                            dbc.Table.from_dataframe(
                                result_df.head(20),
                                striped=True,
                                bordered=True,
                                hover=True,
                                size="sm",
                            ),
                            style={"overflowX": "auto"},
                        ),
                        dbc.Button(
                            "⬇️ Download Full Results CSV",
                            id="download-button",
                            color="success",
                            className="mt-3",
                            n_clicks=0,
                        ),
                    ]
                )
            )

            return False, result_df.to_json(date_format='iso', orient='split'), html.Div(
                [summary_row, charts_row, results_table]
            )
        except Exception as e:
            return False, None, dbc.Alert(f"❌ Error: {str(e)}", color="danger")

    return False, None, dbc.Alert("🔄 Click 'Run Batch Analysis' to process the uploaded CSV.", color="info")


@callback(
    Output("comparison-output", "children"),
    Input("model-selector", "value"),
)
def render_comparison(selected_model):
    """Render model comparison tab."""
    if not metadata or "models" not in metadata or not metadata["models"]:
        return dbc.Alert(
            "📊 No model metrics found. Run `python scripts/generate_model_artifacts.py` after training.",
            color="info",
        )

    m = metadata["models"]
    lr = m.get("logistic_regression")
    ls = m.get("bilstm")

    if not lr or not ls:
        return dbc.Alert(
            "⚠️ Metrics for both models are needed. Only one model's data was found.",
            color="warning",
        )

    # Metrics table
    metrics_df = pd.DataFrame(
        {
            "Metric": ["Accuracy", "Macro F1", "Weighted F1", "Training Time", "Model Size"],
            "Logistic Regression": [
                f"{lr['accuracy']*100:.1f}%",
                f"{lr['macro_f1']:.2f}",
                f"{lr['weighted_f1']:.2f}",
                f"~{lr['approx_training_time_seconds']}s",
                f"~{lr['approx_model_size_mb']}MB",
            ],
            "BiLSTM": [
                f"{ls['accuracy']*100:.1f}%",
                f"{ls['macro_f1']:.2f}",
                f"{ls['weighted_f1']:.2f}",
                f"~{ls['approx_training_time_seconds']}s",
                f"~{ls['approx_model_size_mb']}MB",
            ],
        }
    )

    # Comparison charts
    accuracy_fig = go.Figure(
        data=[
            go.Bar(
                name="Logistic Regression",
                x=["Accuracy"],
                y=[lr["accuracy"] * 100],
                marker=dict(color="#4F46E5"),
                text=[f"{lr['accuracy']*100:.1f}%"],
                textposition="outside",
            ),
            go.Bar(
                name="BiLSTM",
                x=["Accuracy"],
                y=[ls["accuracy"] * 100],
                marker=dict(color="#7C3AED"),
                text=[f"{ls['accuracy']*100:.1f}%"],
                textposition="outside",
            ),
        ]
    )
    accuracy_fig.update_layout(
        title="Accuracy Comparison",
        yaxis_title="Accuracy (%)",
        showlegend=True,
        template="plotly_white",
        height=350,
        barmode="group",
        margin=dict(l=40, r=20, t=40, b=40),
    )

    f1_fig = go.Figure(
        data=[
            go.Bar(
                name="Logistic Regression",
                x=["Macro F1"],
                y=[lr["macro_f1"]],
                marker=dict(color="#4F46E5"),
                text=[f"{lr['macro_f1']:.2f}"],
                textposition="outside",
            ),
            go.Bar(
                name="BiLSTM",
                x=["Macro F1"],
                y=[ls["macro_f1"]],
                marker=dict(color="#7C3AED"),
                text=[f"{ls['macro_f1']:.2f}"],
                textposition="outside",
            ),
        ]
    )
    f1_fig.update_layout(
        title="Macro F1 Comparison",
        yaxis_title="F1 Score",
        showlegend=True,
        template="plotly_white",
        height=350,
        barmode="group",
        margin=dict(l=40, r=20, t=40, b=40),
    )

    # Per-class F1
    per_class_fig = go.Figure(
        data=[
            go.Bar(
                name="Logistic Regression",
                x=config.SENTIMENT_CLASSES,
                y=[lr["per_class_f1"].get(c, 0) for c in config.SENTIMENT_CLASSES],
                marker=dict(color="#4F46E5"),
            ),
            go.Bar(
                name="BiLSTM",
                x=config.SENTIMENT_CLASSES,
                y=[ls["per_class_f1"].get(c, 0) for c in config.SENTIMENT_CLASSES],
                marker=dict(color="#7C3AED"),
            ),
        ]
    )
    per_class_fig.update_layout(
        title="Per-Class F1 Score",
        yaxis_title="F1 Score",
        showlegend=True,
        template="plotly_white",
        height=350,
        barmode="group",
        margin=dict(l=40, r=20, t=40, b=40),
    )

    # Confusion matrices
    lr_cm = error_data.get("models", {}).get("logistic_regression", {}).get("confusion_matrix")
    ls_cm = error_data.get("models", {}).get("bilstm", {}).get("confusion_matrix")

    confusion_content = []
    if lr_cm:
        confusion_content.append(
            dbc.Row(
                dbc.Col(
                    dcc.Graph(
                        figure=create_confusion_matrix_heatmap(lr_cm, config.SENTIMENT_CLASSES, "Confusion Matrix — Logistic Regression")
                    ),
                    md=6,
                ),
                className="mt-4 mb-4",
            )
        )
    if ls_cm:
        confusion_content.append(
            dbc.Row(
                dbc.Col(
                    dcc.Graph(
                        figure=create_confusion_matrix_heatmap(ls_cm, config.SENTIMENT_CLASSES, "Confusion Matrix — BiLSTM")
                    ),
                    md=6,
                ),
                className="mt-4 mb-4",
            )
        )

    return html.Div(
        [
            dbc.Card(
                dbc.CardBody(
                    [
                        html.H6("📈 Metrics Comparison"),
                        html.Div(
                            dbc.Table.from_dataframe(metrics_df, striped=True, bordered=True, hover=True),
                            style={"overflowX": "auto"},
                        ),
                    ]
                ),
                className="mb-4",
            ),
            dbc.Row(
                [
                    dbc.Col(dcc.Graph(figure=accuracy_fig), md=6),
                    dbc.Col(dcc.Graph(figure=f1_fig), md=6),
                ],
                className="mb-4 g-3",
            ),
            dbc.Row(
                dbc.Col(dcc.Graph(figure=per_class_fig), md=8),
                className="mb-4",
            ),
            html.H6("🔄 Confusion Matrices", className="mt-4"),
            *confusion_content,
            html.Hr(),
            dbc.Row(
                [
                    dbc.Col(
                        dbc.Card(
                            dbc.CardBody(
                                [
                                    html.H6("⚡ Fast & Interpretable"),
                                    html.Strong("TF-IDF + Logistic Regression"),
                                    html.Ul(
                                        [
                                            html.Li("Low latency"),
                                            html.Li("Limited hardware"),
                                            html.Li("Explainability matters"),
                                        ]
                                    ),
                                ]
                            ),
                            className="recommendation-card",
                        ),
                        md=6,
                    ),
                    dbc.Col(
                        dbc.Card(
                            dbc.CardBody(
                                [
                                    html.H6("🧠 Higher Accuracy"),
                                    html.Strong("BiLSTM"),
                                    html.Ul(
                                        [
                                            html.Li("Accuracy priority"),
                                            html.Li("Word order matters"),
                                            html.Li("Higher compute acceptable"),
                                        ]
                                    ),
                                ]
                            ),
                            className="recommendation-card",
                        ),
                        md=6,
                    ),
                ],
                className="g-3",
            ),
        ]
    )


@callback(
    Output("error-output", "children"),
    Input("model-selector", "value"),
)
def render_error_analysis(selected_model):
    """Render error analysis tab."""
    if not error_data or "models" not in error_data or not error_data["models"]:
        return dbc.Alert(
            "📊 No error-analysis data found. Run `python scripts/generate_model_artifacts.py`.",
            color="info",
        )

    # Get data for first available model
    model_key = None
    if "logistic_regression" in error_data.get("models", {}):
        model_key = "logistic_regression"
        model_name = "Logistic Regression"
    elif "bilstm" in error_data.get("models", {}):
        model_key = "bilstm"
        model_name = "BiLSTM"

    if not model_key:
        return dbc.Alert("⚠️ No error analysis available for any model.", color="warning")

    info = error_data["models"][model_key]

    # Confusion pairs table
    pairs = info.get("top_confusion_pairs", {})
    pairs_df = pd.DataFrame([{"Actual → Predicted": k, "Count": v} for k, v in pairs.items()])

    # Misclassified examples
    examples = info.get("misclassified_examples", [])[:20]
    if examples:
        ex_df = pd.DataFrame(examples)[["actual", "predicted", "confidence", "tweet"]]
        ex_df.columns = ["Actual", "Predicted", "Confidence", "Tweet"]
    else:
        ex_df = pd.DataFrame()

    return html.Div(
        [
            html.H6(f"❌ Error Analysis — {model_name}"),
            dbc.Card(
                dbc.CardBody(
                    [
                        html.H6("🔀 Most Confused Classes"),
                        html.Div(
                            dbc.Table.from_dataframe(pairs_df, striped=True, bordered=True, hover=True),
                            style={"overflowX": "auto"},
                        ),
                    ]
                ),
                className="mb-4",
            ),
            dbc.Card(
                dbc.CardBody(
                    [
                        html.H6("❌ Misclassified Examples (sample)"),
                        html.Div(
                            dbc.Table.from_dataframe(ex_df, striped=True, bordered=True, hover=True, size="sm")
                            if not ex_df.empty
                            else html.P("No misclassified examples to show."),
                            style={"overflowX": "auto"},
                        ),
                    ]
                ),
                className="mb-4",
            ),
            html.Hr(),
            html.H6("⚠️ Limitations"),
            dbc.Alert(
                html.Ul(
                    [
                        html.Li("Training dataset is airline-specific; results may not generalize."),
                        html.Li("Neutral sentiment is the hardest class for both models (F1 ≈ 0.60)."),
                        html.Li("Sarcasm and mixed sentiment remain challenging."),
                        html.Li("Live Twitter/X data is not connected (X API is no longer free)."),
                        html.Li("Live Stream tab uses simulated timestamps for demonstration."),
                    ]
                ),
                color="light",
            ),
        ]
    )


@callback(
    Output("about-output", "children"),
    Input("model-selector", "value"),
)
def render_about(selected_model):
    """Render about/methodology tab."""
    dist = metadata.get("class_distribution", {}) if metadata else {}

    dataset_info = []
    if metadata:
        dataset_info = [
            create_kpi_card("Total Tweets", f"{metadata.get('dataset_size', 0):,}", "📊"),
            create_kpi_card(
                "Negative", f"{dist.get('negative', 0)*100:.1f}%", "😞", SENTIMENT_COLORS["negative"]
            ),
            create_kpi_card(
                "Neutral", f"{dist.get('neutral', 0)*100:.1f}%", "😐", SENTIMENT_COLORS["neutral"]
            ),
            create_kpi_card(
                "Positive", f"{dist.get('positive', 0)*100:.1f}%", "😊", SENTIMENT_COLORS["positive"]
            ),
        ]

    dist_fig = None
    if dist and metadata:
        dist_series = pd.Series({k: v * 100 for k, v in dist.items()})
        dist_fig = go.Figure(
            data=[
                go.Bar(
                    x=dist_series.index,
                    y=dist_series.values,
                    marker=dict(color=[SENTIMENT_COLORS.get(c, "#334155") for c in dist_series.index]),
                    text=dist_series.values.round(1),
                    textposition="outside",
                    hovertemplate="<b>%{x}</b><br>%: %{y:.1f}%<extra></extra>",
                )
            ]
        )
        dist_fig.update_layout(
            title="Class Distribution",
            yaxis_title="% of Dataset",
            showlegend=False,
            template="plotly_white",
            height=400,
            margin=dict(l=40, r=20, t=40, b=40),
        )

    return html.Div(
        [
            html.H6("📊 Dataset Statistics"),
            dbc.Row(
                [dbc.Col(card, md=3, className="mb-3") for card in dataset_info],
                className="g-3 mb-4",
            ),
            dbc.Row(
                dbc.Col(
                    dcc.Graph(figure=dist_fig) if dist_fig else html.P("No data available."),
                    md=8,
                ),
                className="mb-4",
            ),
            html.Hr(),
            html.H6("📐 Methodology & Pipeline"),
            dbc.Card(
                dbc.CardBody(
                    [
                        html.Pre(
                            """                              Tweet
                                │
                          Text Cleaning
             (lowercase, strip URLs/mentions, lemmatize,
                    remove stopwords, keep negations)
                                │
                 ┌──────────────┴──────────────┐
                 │                              │
             TF-IDF                       Tokenization
        (unigrams + bigrams)               + Padding
                 │                              │
        Logistic Regression                Embedding(128)
                 │                              │
                 │                       Bidirectional LSTM(64)
                 │                              │
                 │                         Dense(64, ReLU)
                 │                              │
                 │                          Dropout(0.3)
                 │                              │
                 └──────────────┬───────────────┘
                                │
                      Dense(3, Softmax)
                                │
                       Sentiment (pos / neu / neg)
                                │
                          Dashboard (this app)""",
                            style={
                                "fontFamily": "monospace",
                                "fontSize": "12px",
                                "whiteSpace": "pre-wrap",
                                "wordWrap": "break-word",
                            },
                        ),
                        html.P(
                            "Both models share the exact same cleaning pipeline (src/text_utils.py) "
                            "so predictions are directly comparable.",
                            className="mt-3",
                        ),
                    ]
                ),
                className="mb-4",
            ),
            html.Hr(),
            html.H6("💡 Key Insights"),
            dbc.Alert(
                html.Ul(
                    [
                        html.Li(
                            html.Strong("TF-IDF + Logistic Regression: "),
                            "Fast, lightweight, and interpretable. Best for latency-sensitive applications.",
                        ),
                        html.Li(
                            html.Strong("BiLSTM: "),
                            "Captures sequential patterns and context. Higher accuracy at the cost of compute.",
                        ),
                        html.Li(
                            html.Strong("Neutral Sentiment: "),
                            "The hardest class for both models. Short, factual, or question-style tweets often lack strong sentiment cues.",
                        ),
                        html.Li(
                            html.Strong("Dataset: "),
                            "Airline-specific domain (14,640 tweets). Consider retraining on your own data for domain-specific accuracy.",
                        ),
                    ]
                ),
                color="light",
            ),
        ]
    )


