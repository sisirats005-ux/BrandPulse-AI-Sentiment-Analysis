# ============================================================================
# Helper functions
# ============================================================================
def load_stream_pool(sample_size: int = 400) -> list:
    """Load real tweets from dataset to simulate live stream."""
    if os.path.exists(config.DATA_PATH):
        try:
            df = pd.read_csv(config.DATA_PATH)
        except UnicodeDecodeError:
            df = pd.read_csv(config.DATA_PATH, encoding="latin-1")
        text_col = next((c for c in ["text", "tweet", "content"] if c in df.columns), None)
        if text_col:
            texts = df[text_col].dropna().astype(str).tolist()
            if len(texts) > sample_size:
                texts = random.sample(texts, sample_size)
            return texts
    return FALLBACK_STREAM_TWEETS


def simulated_timestamps(n: int) -> list:
    """Generate simulated timestamps across the last 24 hours."""
    now = datetime.now()
    start = now - timedelta(hours=24)
    step = timedelta(hours=24) / max(n, 1)
    out = []
    for i in range(n):
        jitter = timedelta(
            minutes=random.uniform(
                -step.total_seconds() / 120, step.total_seconds() / 120
            )
        )
        out.append(start + step * i + jitter)
    return out


def run_prediction_full(texts: list, model_choice: str) -> Tuple:
    """Run prediction with chosen model. Returns (preds, conf, proba, classes)."""
    if model_choice == "TF-IDF + Logistic Regression":
        return predict_logreg(texts, logreg_model, tfidf_vec)
    return predict_lstm(texts, lstm_model, lstm_tok, lstm_cfg)


def parse_contents(contents: str, filename: str) -> Optional[pd.DataFrame]:
    """Parse uploaded CSV file content."""
    if not contents:
        return None
    content_type, content_string = contents.split(",")
    try:
        decoded = base64.b64decode(content_string)
        try:
            df = pd.read_csv(io.StringIO(decoded.decode("utf-8")))
        except UnicodeDecodeError:
            df = pd.read_csv(io.StringIO(decoded.decode("latin-1")))
        return df
    except Exception:
        return None


def hourly_trend(buffer_df: pd.DataFrame) -> pd.DataFrame:
    """Compute hourly sentiment breakdown as percentages."""
    if buffer_df.empty:
        return pd.DataFrame(columns=["positive", "neutral", "negative"])
    df = buffer_df.copy()
    df["hour"] = df["timestamp"].dt.floor("h")
    pivot = df.groupby(["hour", "sentiment"]).size().unstack(fill_value=0)
    for col in ["positive", "neutral", "negative"]:
        if col not in pivot.columns:
            pivot[col] = 0
    pivot = pivot[["positive", "neutral", "negative"]]
    pct = pivot.div(pivot.sum(axis=1), axis=0) * 100
    pct.index = pct.index.strftime("%H:%M")
    return pct.round(1)


def create_kpi_card(title: str, value: str, icon: str = "📊", color: str = "#4F46E5") -> dbc.Card:
    """Create a KPI card component."""
    return dbc.Card(
        dbc.CardBody(
            [
                html.Div(
                    [
                        html.Span(icon, className="kpi-icon"),
                        html.Div(
                            [
                                html.Div(value, className="kpi-value"),
                                html.Div(title, className="kpi-label"),
                            ],
                            className="kpi-text",
                        ),
                    ],
                    className="kpi-content",
                ),
            ]
        ),
        className="kpi-card",
        style={"borderLeftColor": color},
    )


def create_sentiment_badge(label: str, confidence: float) -> html.Div:
    """Create a sentiment prediction badge."""
    color = SENTIMENT_COLORS.get(label, "#334155")
    return html.Div(
        [
            html.Span(label.upper(), style={"fontWeight": "700", "fontSize": "24px"}),
            html.Span(
                f" · {confidence*100:.1f}% confidence",
                style={"opacity": "0.85", "fontWeight": "600", "fontSize": "16px"},
            ),
        ],
        style={
            "display": "inline-flex",
            "alignItems": "center",
            "gap": "12px",
            "padding": "16px 28px",
            "borderRadius": "9999px",
            "background": color,
            "color": "white",
            "fontWeight": "700",
            "fontSize": "20px",
            "boxShadow": f"0 8px 20px -8px {color}99",
            "marginBottom": "16px",
        },
    )


def create_probability_bars(classes: list, proba_row: np.ndarray) -> html.Div:
    """Create probability bars for each sentiment class."""
    bars = []
    order = sorted(zip(classes, proba_row), key=lambda x: -x[1])
    top_label, top_p = order[0]

    for label, p in order:
        color = SENTIMENT_COLORS.get(label, "#334155")
        bars.append(
            html.Div(
                [
                    html.Div(
                        [
                            html.Span(
                                label.capitalize(),
                                style={"fontWeight": "600", "textTransform": "capitalize"},
                            ),
                            html.Span(
                                f"{p*100:.1f}%",
                                style={"fontWeight": "700", "color": color},
                            ),
                        ],
                        style={
                            "display": "flex",
                            "justifyContent": "space-between",
                            "fontSize": "13px",
                            "color": "#334155",
                            "marginBottom": "6px",
                        },
                    ),
                    html.Div(
                        html.Div(
                            style={
                                "width": f"{max(p*100, 1):.1f}%",
                                "background": f"linear-gradient(90deg, {color}CC, {color})",
                                "height": "10px",
                                "borderRadius": "6px",
                                "transition": "width 0.3s ease",
                            }
                        ),
                        style={
                            "background": "#EEF0F4",
                            "borderRadius": "6px",
                            "height": "10px",
                            "overflow": "hidden",
                        },
                    ),
                ],
                style={"marginBottom": "12px"},
            )
        )

    content = [html.Div(bars)]
    if top_p < LOW_CONFIDENCE_THRESHOLD:
        breakdown = ", ".join(f"{l.capitalize()}: {p*100:.0f}%" for l, p in order)
        content.append(
            dbc.Alert(
                f"⚠️ Low-confidence prediction — the model is uncertain ({breakdown}).",
                color="warning",
                className="mt-3",
            )
        )

    return html.Div(content)


def create_sentiment_distribution_chart(sentiment_series: pd.Series) -> go.Figure:
    """Create a Plotly bar chart for sentiment distribution."""
    counts = sentiment_series.value_counts()
    colors = [SENTIMENT_COLORS.get(c, "#334155") for c in counts.index]

    fig = go.Figure(
        data=[
            go.Bar(
                x=counts.index,
                y=counts.values,
                marker=dict(color=colors),
                text=counts.values,
                textposition="outside",
                hovertemplate="<b>%{x}</b><br>Tweets: %{y}<extra></extra>",
            )
        ]
    )
    fig.update_layout(
        title="Sentiment Distribution",
        xaxis_title=None,
        yaxis_title="Tweets",
        hovermode="x unified",
        showlegend=False,
        template="plotly_white",
        height=350,
        margin=dict(l=40, r=20, t=40, b=40),
    )
    return fig


def create_confidence_histogram(confidence_series: pd.Series) -> go.Figure:
    """Create a Plotly histogram for confidence distribution."""
    fig = go.Figure(
        data=[
            go.Histogram(
                x=confidence_series,
                nbinsx=20,
                marker=dict(color="#4F46E5"),
                hovertemplate="Confidence: %{x:.2f}<br>Count: %{y}<extra></extra>",
            )
        ]
    )
    fig.update_layout(
        title="Confidence Distribution",
        xaxis_title="Confidence",
        yaxis_title="Tweets",
        showlegend=False,
        template="plotly_white",
        height=350,
        margin=dict(l=40, r=20, t=40, b=40),
    )
    return fig


def create_confusion_matrix_heatmap(cm: list, classes: list, title: str) -> go.Figure:
    """Create a confusion matrix heatmap."""
    cm = np.array(cm)
    fig = go.Figure(
        data=go.Heatmap(
            z=cm,
            x=classes,
            y=classes,
            colorscale="Blues",
            text=cm,
            texttemplate="%{text}",
            textfont={"size": 12},
            hovertemplate="Actual: %{y}<br>Predicted: %{x}<br>Count: %{z}<extra></extra>",
        )
    )
    fig.update_layout(
        title=title,
        xaxis_title="Predicted",
        yaxis_title="Actual",
        height=400,
        margin=dict(l=80, r=20, t=40, b=40),
    )
    return fig


def create_trend_chart(trend_df: pd.DataFrame) -> go.Figure:
    """Create a line chart for sentiment trend over time."""
    if trend_df.empty:
        return go.Figure().add_annotation(text="No data available")

    fig = go.Figure()
    colors = {
        "positive": SENTIMENT_COLORS["positive"],
        "neutral": SENTIMENT_COLORS["neutral"],
        "negative": SENTIMENT_COLORS["negative"],
    }

    for sentiment in ["positive", "neutral", "negative"]:
        if sentiment in trend_df.columns:
            fig.add_trace(
                go.Scatter(
                    x=trend_df.index,
                    y=trend_df[sentiment],
                    mode="lines+markers",
                    name=sentiment.capitalize(),
                    line=dict(color=colors.get(sentiment, "#334155"), width=2),
                    marker=dict(size=6),
                    hovertemplate="<b>%{fullData.name}</b><br>Time: %{x}<br>%: %{y:.1f}%<extra></extra>",
                )
            )

    fig.update_layout(
        title="24-Hour Sentiment Trend",
        xaxis_title="Time",
        yaxis_title="Percentage (%)",
        hovermode="x unified",
        template="plotly_white",
        height=400,
        margin=dict(l=40, r=20, t=40, b=40),
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1),
    )
    return fig


